{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "health-classroom-kit",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
  },
  "durable_objects": {
    "bindings": [{ "name": "CLASSROOM", "class_name": "ClassroomDurableObject" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ClassroomDurableObject"] }],
  "vars": {
    "APP_MODE": "demo",
    "APP_INSTANCE": "default",
    "ALLOW_PUBLIC_DEMO": "false",
    "AI_BASE_URL": "https://api.openai.com/v1",
    "AI_DAILY_LIMIT": "20",
  },
  "dev": { "ip": "127.0.0.1", "port": 8787 },
}
