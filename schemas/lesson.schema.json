{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Health Classroom Kit lesson v1",
  "description": "教材交換格式。活動 ID 與投影片 ID 的跨項目唯一性、答案索引上限及量尺 max > min 由 Worker 額外驗證。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "title", "description", "subject", "duration", "objectives", "slides"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "$ref": "#/$defs/id" },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "description": { "type": "string", "maxLength": 3000 },
    "subject": { "type": "string", "maxLength": 100 },
    "duration": { "type": "integer", "minimum": 1, "maximum": 600 },
    "objectives": { "$ref": "#/$defs/texts" },
    "slides": { "type": "array", "minItems": 1, "maxItems": 60, "items": { "$ref": "#/$defs/slide" } },
    "updatedAt": { "type": "string", "format": "date-time", "description": "儲存時由後端重設。" }
  },
  "$defs": {
    "id": {
      "type": "string", "minLength": 1, "maxLength": 100,
      "pattern": "^[a-zA-Z0-9_-]+$",
      "not": { "enum": ["__proto__", "constructor", "prototype"] }
    },
    "texts": { "type": "array", "maxItems": 20, "items": { "type": "string", "maxLength": 3000 } },
    "slide": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "title", "body"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1, "maxLength": 300 },
        "eyebrow": { "type": "string", "maxLength": 5000 },
        "body": { "type": "string", "maxLength": 10000 },
        "bullets": { "$ref": "#/$defs/texts" },
        "visual": { "enum": ["balance", "steps", "cards", "bars"] },
        "activity": { "$ref": "#/$defs/activity" },
        "notes": { "type": "string", "maxLength": 5000 },
        "source": { "type": "string", "maxLength": 5000 },
        "customHtml": { "type": "string", "maxLength": 40000 }
      }
    },
    "activity": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "type", "prompt"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "enum": ["single", "multiple", "scale", "short"] },
        "prompt": { "type": "string", "minLength": 1, "maxLength": 3000 },
        "options": { "type": "array", "minItems": 2, "maxItems": 12, "items": { "type": "string", "maxLength": 3000 } },
        "correct": { "type": "array", "uniqueItems": true, "items": { "type": "integer", "minimum": 0, "maximum": 11 } },
        "min": { "type": "integer", "minimum": 0, "maximum": 99, "default": 1 },
        "max": { "type": "integer", "minimum": 1, "maximum": 100, "default": 5 },
        "minLabel": { "type": "string", "maxLength": 100 },
        "maxLabel": { "type": "string", "maxLength": 100 },
        "explanation": { "type": "string", "maxLength": 4000 },
        "sensitive": { "type": "boolean", "default": false },
        "aiAllowed": { "type": "boolean", "default": false }
      },
      "allOf": [
        { "if": { "properties": { "type": { "enum": ["single", "multiple"] } } }, "then": { "required": ["options"] } },
        { "if": { "properties": { "type": { "const": "single" } } }, "then": { "properties": { "correct": { "minItems": 1, "maxItems": 1 } } } }
      ]
    }
  }
}
